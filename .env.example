# ============================================================
#  Bot settings
#  Copy this file to `.env` and fill in the real values.
#  ⚠️ Never share your `.env` — it holds secrets.
# ============================================================

# ---------- Audio server (NodeLink) ----------
# The bot connects to NodeLink (not Lavalink) on the same VPS.
# Format: name|host:port|password|secure — separate multiple servers with ;
LAVALINK_NODES=main|localhost:3000|youshallnotpass|false

# ---------- Search & playback ----------
# Default search source: ytsearch (YouTube)
DEFAULT_SEARCH=ytsearch

# Default volume (0-150)
DEFAULT_VOLUME=100
# Max volume
MAX_VOLUME=150
# Max queue size
MAX_QUEUE=500

# Auto Now Playing message on track start (default: off).
# Set NP_AUTO=true to bring it back.
# NP_AUTO=true

# Idle-leave delay (seconds) for unpinned bots.
LEAVE_AFTER_SECONDS=120

# ---------- Bot owner ----------
# Owner user IDs, comma-separated. Only they can run Owner commands.
OWNER_IDS=your_discord_user_id

# ---------- Prefix (optional — commands work with no prefix) ----------
# Commands work with NO prefix. The prefix is only used to target one
# specific bot when you have many: Bot#1 "!", Bot#2 "!2", Bot#3 "!3"...
# To set custom prefixes, list them here in order (one per bot in tokens.txt):
# JMUSIC_PREFIXES=!,!2,!3,$
JMUSIC_PREFIXES=
JMUSIC_PREFIX=!
# Max track length in seconds (0 = no limit)
JMUSIC_MAX_TIME=0
# Max YouTube playlist pages (~100 tracks each)
JMUSIC_MAX_YT_PLAYLIST_PAGES=10
# Local playlists folder
JMUSIC_PLAYLISTS_FOLDER=Playlists
