# ============================================================
#  Bot settings
#  Copy this file to `.env` and fill in the real values.
#  ⚠️ Never share your `.env` — it holds secrets.
# ============================================================

# ---------- Audio server (NodeLink) ----------
# The bot connects to NodeLink (not Lavalink) on the same machine.
# Format: name|host:port|password|secure — separate multiple servers with ;
# Put your NodeLink host where it says localhost, its port where it says 3000,
# and your NodeLink password where it says your_nodelink_password.
LAVALINK_NODES=main|localhost:3000|your_nodelink_password|false

# ---------- Search & playback ----------
# Default search source: ytsearch (YouTube)
DEFAULT_SEARCH=ytsearch

# Default volume (0-150)
DEFAULT_VOLUME=100
# Max volume
MAX_VOLUME=150
# Max queue size
MAX_QUEUE=500

# Auto Now Playing message on track start (default: off).
# Set NP_AUTO=true to bring it back.
# NP_AUTO=true

# Idle-leave delay (seconds) for unpinned bots.
LEAVE_AFTER_SECONDS=120

# ---------- Bot owner ----------
# Owner user IDs, comma-separated. Only they can run Owner commands.
OWNER_IDS=your_discord_user_id

# ---------- Sky emojis (music1/2/3) ----------
# The bot shows custom sky emojis (music1, music2, music3) in its replies,
# embeds, and the filter picker. These are custom Discord emojis, so they
# only exist on the server they were uploaded to.
# Upload the three emojis to YOUR Discord server first, then put their IDs
# here (type \:music1: in Discord chat to see its <:music1:ID> form, and
# copy the number). The values below are the author's own server emoji IDs
# — they work as-is on his server, but on any other server they will render
# broken unless you replace them with your own.
EMOJI_MUSIC1_ID=1575843561285361825
EMOJI_MUSIC2_ID=1575843586338062386
EMOJI_MUSIC3_ID=1575843610270634064

# ---------- Prefix (optional — commands work with no prefix) ----------
# Commands work with NO prefix. The prefix is only used to target one
# specific bot when you have many: Bot#1 "!", Bot#2 "!2", Bot#3 "!3"...
# To set custom prefixes, list them here in order (one per bot in tokens.txt):
# JMUSIC_PREFIXES=!,!2,!3,$
JMUSIC_PREFIXES=
JMUSIC_PREFIX=!
# Max track length in seconds (0 = no limit)
JMUSIC_MAX_TIME=0
# Max YouTube playlist pages (~100 tracks each)
JMUSIC_MAX_YT_PLAYLIST_PAGES=10
# Local playlists folder
JMUSIC_PLAYLISTS_FOLDER=Playlists
