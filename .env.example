# ============================================================
#  إعدادات البوت — Bot settings
#  انسخ الملف ده باسم `.env` واملأ القيم الحقيقية.
#  Copy this file to `.env` and fill in the real values.
#  ⚠️ متشاركش ملف `.env` مع حد — فيه بيانات سرية.
#  Never share your `.env` — it holds secrets.
# ============================================================

# ---------- التوكنات — Bot tokens ----------
# تقدر تحطها هنا مفصولة بفاصلة، أو (الأفضل) في ملف tokens.txt
# كل توكن في سطر. التوكن الواحد = بوت واحد.
# You can list tokens here comma-separated, or (better) in tokens.txt,
# one token per line. One token = one bot.
TOKENS=

# ---------- سيرفر الصوت — Audio server (NodeLink) ----------
# البوت بيتصل بـ NodeLink (مش Lavalink) على نفس الـ VPS.
# الصيغة: name|host:port|password|secure — ولو أكتر من سيرفر افصل بينهم بـ ;
# The bot connects to NodeLink (not Lavalink) on the same VPS.
# Format: name|host:port|password|secure — separate multiple servers with ;
LAVALINK_NODES=main|localhost:3000|youshallnotpass|false

# ---------- البحث والتشغيل — Search & playback ----------
# مصدر البحث الافتراضي: ytsearch (يوتيوب)
# Default search source: ytsearch (YouTube)
DEFAULT_SEARCH=ytsearch

# الصوت الافتراضي (0-150) — Default volume
DEFAULT_VOLUME=100
# أقصى صوت مسموح — Max volume
MAX_VOLUME=150
# أقصى عدد أغاني في القائمة — Max queue size
MAX_QUEUE=500

# رسالة Now Playing التلقائية مع بداية كل أغنية (افتراضي: مش بتظهر)
# حط NP_AUTO=true لو عايزها ترجع.
# Auto Now Playing message on track start (default: off).
# Set NP_AUTO=true to bring it back.
# NP_AUTO=true

# البوت غير المثبت يخرج بعد كام ثانية لو الروم فضي أو القائمة خلصت
# Idle-leave delay (seconds) for unpinned bots.
LEAVE_AFTER_SECONDS=120

# ---------- الأونر — Bot owner ----------
# آيديهات أصحاب البوت (لأوامر الـ Owner زي setname و shutdown) مفصولة بفاصلة.
# Owner user IDs, comma-separated. Only they can run Owner commands.
OWNER_IDS=your_discord_user_id

# ---------- البريفكس (اختياري — الأوامر شغالة من غير بريفكس) ----------
# الأوامر بتشتغل من غير بريفكس أصلًا: اكتب "شغل تملي معاك" والبوت اللي
# معاك في الروم هو اللي هيرد. البريفكس بس عشان تستهدف بوت معين لو عندك
# بوتات كتير: البوت الأول "!"، التاني "!2"، التالت "!3"...
# Commands work with NO prefix. The prefix is only used to target one
# specific bot when you have many: Bot#1 "!", Bot#2 "!2", Bot#3 "!3"...
# لو عايز بريفكسات معينة، اكتبها هنا بالترتيب (واحد لكل بوت في tokens.txt):
# To set custom prefixes, list them here in order (one per bot in tokens.txt):
# JMUSIC_PREFIXES=!,!2,!3,$
JMUSIC_PREFIXES=
JMUSIC_PREFIX=!
# أقصى مدة لأي أغنية بالثواني (0 = مفيش حد) — Max track length in seconds (0 = no limit)
JMUSIC_MAX_TIME=0
# أقصى عدد صفحات بلاي ليست يوتيوب (كل صفحة ~100 أغنية)
# Max YouTube playlist pages (~100 tracks each)
JMUSIC_MAX_YT_PLAYLIST_PAGES=10
# فولدر البلاي ليستات المحلية — Local playlists folder
JMUSIC_PLAYLISTS_FOLDER=Playlists
